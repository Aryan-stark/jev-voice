# Required: https://console.typesafe.ai
TYPESAFE_API_KEY=

# Feedback after an action: ding (chime) | voice (spoken butler)
FEEDBACK=ding
# PERSONA=jarvis (crisp AI assistant, uses USER_NAME) | alfred (posh UK butler) | cowboy | plain
# Persona only affects spoken replies, so it needs FEEDBACK=voice to be heard.
PERSONA=alfred
USER_NAME=Wayne

# Optional better voice (ElevenLabs Flash, cached to disk). Defaults: alfred=George, cowboy=Bill
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Hands-free: names that address the assistant; follow-up window after a command (seconds)
WAKE_WORDS=sofia,sophia,sofie,sophie,sofya
FOLLOWUP_SECONDS=8
# Unnamed utterances: 1 = let Jev judge if it's a command; gates 0..1 (0 = never ignore)
UNNAMED_COMMANDS=1
UNNAMED_MIN_ADDRESSED=0
UNNAMED_MIN_CONFIDENCE=0

# OVERLAY=0 to hide the floating transcription pill
OVERLAY=1

# --- automation ---
# Bound every AppleScript call; without this a missing permission hangs the assistant.
OSASCRIPT_TIMEOUT=5
# How long to wait before restoring the clipboard after a paste.
PASTE_RESTORE_DELAY=0.6
# Max wait for the browser tab list before giving up on it for that command.
TAB_TIMEOUT=0.5
# Per-step ceiling inside a saved routine (macros.json).
MACRO_STEP_TIMEOUT=6
# Dictation auto-exits after this long with nothing said.
DICTATION_IDLE_SECONDS=120
# JEV_MACROS=/path/to/macros.json   # default: ~/.config/jev-voice/macros.json, else ./macros.json

# --- planner (escalation tier) ---
# When Jev is out of its depth it hands the request to a local model, which plans from
# the same primitives and is allowed to refuse. Runs offline via Ollama; nothing leaves
# the machine. PLANNER=0 disables it (Jev then guesses, as it used to).
PLANNER=1
PLANNER_MODEL=qwen3:4b-instruct-2507-q4_K_M
PLANNER_TIMEOUT=25
OLLAMA_URL=http://127.0.0.1:11434
# Escalate below this confidence; risky actions (system/shortcut/type) use 0.75.
ESCALATE_BELOW_CONFIDENCE=0.55
